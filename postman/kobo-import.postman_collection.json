{
  "info": {
    "name": "Kobo CSV import",
    "description": "Run with the Collection Runner and a CSV data file. Each CSV row becomes one KoboToolbox submission, built from the CSV's own column names. See postman/README.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Submit row to Kobo",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Build the submission from whatever columns the CSV has.",
              "// A column \"geo/p1\" becomes { geo: { p1: ... } }.",
              "const row = pm.iterationData.toObject();",
              "",
              "// Optional: rename columns, e.g. {\"context/ccp_id\": \"geo/ccp_id\"}",
              "const columnMap = JSON.parse(pm.variables.get(\"column_map\") || \"{}\");",
              "// Optional: extra columns to leave out, comma separated",
              "const skip = (pm.variables.get(\"skip_columns\") || \"\").split(\",\").map(s => s.trim()).filter(Boolean);",
              "",
              "// Kobo export metadata (_id, _submission_time, formhub/uuid, meta/...) is never sent as answers",
              "const isMetadata = name => name.startsWith(\"_\") || name.startsWith(\"formhub/\") || name.startsWith(\"meta/\");",
              "",
              "const submission = {};",
              "for (const [column, raw] of Object.entries(row)) {",
              "  if (isMetadata(column) || skip.includes(column)) continue;",
              "  if (raw === undefined || raw === null || raw.toString() === \"\") continue;  // unanswered",
              "",
              "  const path = (columnMap[column] || column).split(\"/\");",
              "  let node = submission;",
              "  for (const key of path.slice(0, -1)) {",
              "    if (typeof node[key] !== \"object\" || node[key] === null) node[key] = {};",
              "    node = node[key];",
              "  }",
              "  node[path[path.length - 1]] = raw.toString().split(\"%20\").join(\" \");",
              "}",
              "",
              "// Reuse the original ID so a re-run is rejected as duplicate; otherwise make a new one",
              "const originalId = (row[\"meta/instanceID\"] || \"\").toString().replace(/^uuid:/, \"\") || (row[\"_uuid\"] || \"\").toString();",
              "submission.meta = { instanceID: \"uuid:\" + (originalId || pm.variables.replaceIn(\"{{$guid}}\")) };",
              "",
              "pm.variables.set(\"payload\", JSON.stringify({ id: pm.variables.get(\"asset_uid\"), submission }));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const n = pm.info.iteration + 1;",
              "pm.test(`Row ${n}: HTTP ${pm.response.code}`, () => {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201, 202]);",
              "});",
              "if (pm.response.text().toLowerCase().includes(\"duplicate\")) {",
              "  console.log(`Row ${n}: duplicate, already in Kobo`);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Token {{kobo_token}}" },
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{{payload}}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{kobo_url}}"
      }
    }
  ],
  "variable": [
    { "key": "kobo_url", "value": "https://kf.kobotoolbox.org/osmanburcu/submission?format=json", "type": "string" },
    { "key": "asset_uid", "value": "aNAmpcbU9opH9xA6NtbL3x", "type": "string" },
    { "key": "kobo_token", "value": "", "type": "secret" },
    { "key": "column_map", "value": "{}", "type": "string" },
    { "key": "skip_columns", "value": "", "type": "string" }
  ]
}
